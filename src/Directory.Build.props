<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Imported automatically by every project below this folder.
       Projects should not set PlatformToolset themselves, as it would override this value. -->
  <PropertyGroup>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
</Project>
